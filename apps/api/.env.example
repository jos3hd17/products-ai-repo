NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/products_dev
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LOCALLY_GENERATED_RANDOM_SECRET
JWT_ISSUER=product-api
JWT_AUDIENCE=product-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT=5
REFRESH_RATE_LIMIT=20
RATE_WINDOW_MS=60000
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Development docs only; production rejects true and exposes neither UI nor raw contract.
SWAGGER_ENABLED=true
